<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.blockchainer.blockchainer_flutter">
  <application>
    <!--
      Startup hook: Android instantiates this ContentProvider very early in app
      launch, so its onCreate() warms libcryptolib_c + libblockchainer_c on a
      background thread before the first Dart FFI call. authorities uses
      ${applicationId} so it is unique per host app. Not exported; never queried.
      initOrder is below cryptolib_flutter's (100) so its library maps first.
    -->
    <provider
      android:name="com.blockchainer.blockchainer_flutter.BlockchainerStartup"
      android:authorities="${applicationId}.blockchainer-startup"
      android:exported="false"
      android:initOrder="90" />
  </application>
</manifest>
